{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.browser",
    "watchPatterns": [
      "app/**",
      "pyproject.toml",
      "requirements.lock.txt",
      "Dockerfile.browser",
      "railway.browser-worker.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m app.workers.runner --queues portals",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
