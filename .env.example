# Example environment for local development. Copy to .env and adjust.
# Never commit real secrets; these are safe local-only values.

APP_NAME=astra-licensing-automation
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://astra:astra_local_dev@localhost:5442/astra_licensing
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

LOG_LEVEL=INFO
LOG_FORMAT=json
SQL_ECHO=false

CORS_ORIGINS=http://localhost:3000

AUTH_MODE=development
# ENTRA_TENANT_ID=
# ENTRA_API_CLIENT_ID=
# ENTRA_API_AUDIENCE=api://backend-client-id
ENTRA_API_SCOPE=Licensing.Access
# ENTRA_ISSUER=
# ENTRA_OPENID_CONFIGURATION_URL=
ENTRA_JWKS_CACHE_SECONDS=3600
ENTRA_ALLOWED_ALGORITHMS=RS256
ENTRA_CLOCK_SKEW_SECONDS=60
# ENTRA_REQUIRED_TENANT_ID=

# --- Classification, review, and optional model enrichment (Milestone 4) ---
CLASSIFICATION_ENABLED=true
CLASSIFICATION_AUTO_ENQUEUE=true
CLASSIFICATION_RULE_SET=astra-default
CLASSIFICATION_CONFIDENCE_REVIEW_THRESHOLD=0.90
CLASSIFICATION_REVIEW_REQUIRED=true
CLASSIFICATION_JOB_MAX_ATTEMPTS=4
CLASSIFICATION_BODY_MAX_CHARS=40000
CLASSIFICATION_QUOTED_HISTORY_MAX_CHARS=5000

AI_CLASSIFICATION_ENABLED=false
AI_PROVIDER=openai
AI_EXTERNAL_PROVIDER_APPROVED=false
# OPENAI_API_KEY=  # secret manager/environment only; never frontend
# OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_STORE_RESPONSES=false
AI_DATA_POLICY_ACKNOWLEDGED=false
# Add licensing_response_sanitized only after response-drafting data-policy approval.
AI_ALLOWED_DATA_CLASSES=licensing_email_sanitized
AI_MONTHLY_BUDGET_USD=0
AI_DAILY_REQUEST_LIMIT=0

REVIEW_CLAIM_LEASE_MINUTES=30
REVIEW_AUTO_APPROVAL_ENABLED=false
REVIEW_REQUIRE_CORRECTION_REASON=true
REVIEW_INITIAL_ROLLOUT_MODE=true

# Controlled communications (keep Graph mutations disabled until staging acceptance)
COMMUNICATIONS_ENABLED=false
GRAPH_DRAFT_CREATION_ENABLED=false
GRAPH_SEND_ENABLED=false
GRAPH_MESSAGE_MOVE_ENABLED=false
RESPONSE_AI_DRAFTING_ENABLED=false
COMMUNICATION_REQUIRE_SEND_APPROVAL=true
COMMUNICATION_REQUIRE_SEPARATE_SEND_APPROVER=true
COMMUNICATION_REQUIRE_TWO_PERSON_APPROVAL=false
COMMUNICATION_ALLOW_SELF_APPROVAL=false
COMMUNICATION_INITIAL_ROLLOUT_MODE=true
COMMUNICATION_DEFAULT_RECIPIENT_MODE=REPLY
COMMUNICATION_REPLY_ALL_ENABLED=false
COMMUNICATION_REPLY_ALL_REQUIRES_REVIEW=true
COMMUNICATION_BCC_ENABLED=false
COMMUNICATION_BCC_POLICY_ENABLED=false
COMMUNICATION_MAX_TO_RECIPIENTS=5
COMMUNICATION_MAX_CC_RECIPIENTS=10
COMMUNICATION_MAX_TOTAL_RECIPIENTS=15
COMMUNICATION_EXTERNAL_RECIPIENT_REQUIRES_MANAGER=true
COMMUNICATION_DEFAULT_BODY_FORMAT=TEXT
COMMUNICATION_MAX_BODY_CHARS=50000
COMMUNICATION_DEFAULT_SIGNATURE_KEY=licensing-standard
COMMUNICATION_ALLOW_OUTLOOK_EDITING=true
COMMUNICATION_ATTACHMENTS_ENABLED=true
COMMUNICATION_SIMPLE_ATTACHMENT_MAX_BYTES=3000000
COMMUNICATION_LARGE_ATTACHMENTS_ENABLED=false
COMMUNICATION_LARGE_ATTACHMENT_MAX_BYTES=25000000
COMMUNICATION_TOTAL_ATTACHMENT_MAX_BYTES=20000000
COMMUNICATION_UPLOAD_CHUNK_BYTES=3276800
COMMUNICATION_SHARED_MAILBOX_LARGE_ATTACHMENT_ACCEPTED=false
COMMUNICATION_SEND_JOB_MAX_ATTEMPTS=1
COMMUNICATION_SEND_RECONCILIATION_INITIAL_DELAY_SECONDS=5
COMMUNICATION_SEND_RECONCILIATION_MAX_SECONDS=900
COMMUNICATION_SEND_RECONCILIATION_MAX_ATTEMPTS=8
COMMUNICATION_MOVE_POLICY=TASK_DESTINATION
COMMUNICATION_COMPLETED_FOLDER_NAME=10_Completed
COMMUNICATION_MOVE_JOB_MAX_ATTEMPTS=4
COMMUNICATION_MOVE_RECONCILIATION_MAX_ATTEMPTS=5

PROTOTYPE_IMPORT_ROOT=./prototype-data

# --- Microsoft Graph (Milestone 2) ------------------------------------------
# Graph stays disabled by default; enable only with real staging credentials
# supplied via the environment (never commit secrets).
GRAPH_ENABLED=false
GRAPH_EXPECTED_MAILBOX_ADDRESS=astralicensing@example.invalid
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_CREDENTIAL_MODE=client_secret
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_CERTIFICATE_PATH=
# GRAPH_CERTIFICATE_THUMBPRINT=
GRAPH_TOKEN_REFRESH_SKEW_SECONDS=300

PUBLIC_BASE_URL=http://127.0.0.1:8000
GRAPH_NOTIFICATION_PATH=/webhooks/microsoft-graph/messages
GRAPH_LIFECYCLE_PATH=/webhooks/microsoft-graph/lifecycle
GRAPH_WEBHOOK_MAX_BODY_BYTES=262144
# GRAPH_EXPECTED_TENANT_ID=

GRAPH_SUBSCRIPTION_LIFETIME_MINUTES=8640
GRAPH_SUBSCRIPTION_RENEWAL_WINDOW_MINUTES=1440
GRAPH_SUBSCRIPTION_MAINTENANCE_INTERVAL_SECONDS=300
GRAPH_SUBSCRIPTION_CHANGE_TYPES=created,updated,deleted

GRAPH_DELTA_PAGE_SIZE=50
GRAPH_RECONCILIATION_INTERVAL_SECONDS=300

GRAPH_WORKER_POLL_INTERVAL_SECONDS=2
GRAPH_JOB_LEASE_SECONDS=120
GRAPH_JOB_MAX_ATTEMPTS=6
GRAPH_JOB_RETRY_BASE_SECONDS=5
GRAPH_JOB_RETRY_MAX_SECONDS=900
GRAPH_JOB_HEARTBEAT_INTERVAL_SECONDS=30

EVIDENCE_STORAGE_BACKEND=filesystem
FILESYSTEM_EVIDENCE_ROOT=./evidence
MAX_RAW_MIME_BYTES=26214400
MAX_ATTACHMENT_BYTES=26214400
MAX_ATTACHMENTS_PER_MESSAGE=25
QUARANTINE_UNKNOWN_ATTACHMENTS=true

# --- SharePoint governed repository (Milestone 3) --------------------------
# Keep disabled locally. IDs come from the administrator setup runbook; do
# not use library display names as durable configuration.
SHAREPOINT_ENABLED=false
SHAREPOINT_PERMISSION_MODE=sites_selected
# SHAREPOINT_SITE_ID=
# SHAREPOINT_SITE_HOSTNAME=tenant.sharepoint.com
# SHAREPOINT_SITE_PATH=sites/AstraLicensingCompliance
# SHAREPOINT_SITE_WEB_URL=
# SHAREPOINT_EXPECTED_APP_ID=
# SHAREPOINT_NEGATIVE_TEST_SITE_ID=
SHAREPOINT_ENABLE_WRITE_HEALTH_CHECK=false
# SHAREPOINT_MASTER_DOCUMENTS_DRIVE_ID=
# SHAREPOINT_WORKING_DOCUMENTS_DRIVE_ID=
# SHAREPOINT_BONDS_DRIVE_ID=
# SHAREPOINT_SUBMITTED_FILINGS_DRIVE_ID=
# SHAREPOINT_LICENSES_DRIVE_ID=
# SHAREPOINT_CORRESPONDENCE_DRIVE_ID=
# SHAREPOINT_PAYMENTS_DRIVE_ID=
# SHAREPOINT_FORMS_DRIVE_ID=
# SHAREPOINT_QUARANTINE_DRIVE_ID=

SHAREPOINT_SIMPLE_UPLOAD_MAX_BYTES=4194304
SHAREPOINT_UPLOAD_SESSION_THRESHOLD_BYTES=4194304
# Must be a multiple of 327680 bytes (320 KiB).
SHAREPOINT_UPLOAD_CHUNK_BYTES=5242880
SHAREPOINT_UPLOAD_MAX_ATTEMPTS=5
SHAREPOINT_UPLOAD_SESSION_EXPIRY_SKEW_SECONDS=120
SHAREPOINT_UPLOAD_CONFLICT_BEHAVIOR=fail
SHAREPOINT_UPLOAD_TIMEOUT_SECONDS=120

DOCUMENT_MAX_BYTES=104857600
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,text/csv,application/msword,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.csv,.doc,.docx,.xls,.xlsx
DOCUMENT_QUARANTINE_UNKNOWN_TYPES=true
DOCUMENT_REQUIRE_SHA256=true
DOCUMENT_DUPLICATE_POLICY=link_existing
DOCUMENT_FILENAME_MAX_LENGTH=180
DOCUMENT_DOWNLOAD_MAX_BYTES=104857600
DOCUMENT_PREVIEW_ENABLED=false
DOCUMENT_EXPIRY_ALERT_DAYS=120,90,60,30,14,7,0

SHAREPOINT_RECONCILIATION_INTERVAL_SECONDS=900
SHAREPOINT_DELTA_PAGE_SIZE=200
SHAREPOINT_FULL_RECONCILIATION_INTERVAL_HOURS=24
SHAREPOINT_MISSING_ITEM_GRACE_HOURS=24
