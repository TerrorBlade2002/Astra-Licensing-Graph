# Example environment for local development. Copy to .env and adjust.
# Never commit real secrets; these are safe local-only values.

APP_NAME=astra-licensing-automation
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://astra:astra_local_dev@localhost:5442/astra_licensing
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

LOG_LEVEL=INFO
LOG_FORMAT=json
SQL_ECHO=false

CORS_ORIGINS=http://localhost:3000

AUTH_MODE=development

PROTOTYPE_IMPORT_ROOT=./prototype-data

# --- Microsoft Graph (Milestone 2) ------------------------------------------
# Graph stays disabled by default; enable only with real staging credentials
# supplied via the environment (never commit secrets).
GRAPH_ENABLED=false
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_CREDENTIAL_MODE=client_secret
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_CERTIFICATE_PATH=
# GRAPH_CERTIFICATE_THUMBPRINT=
GRAPH_TOKEN_REFRESH_SKEW_SECONDS=300

PUBLIC_BASE_URL=http://127.0.0.1:8000
GRAPH_NOTIFICATION_PATH=/webhooks/microsoft-graph/messages
GRAPH_LIFECYCLE_PATH=/webhooks/microsoft-graph/lifecycle
GRAPH_WEBHOOK_MAX_BODY_BYTES=262144
# GRAPH_EXPECTED_TENANT_ID=

GRAPH_SUBSCRIPTION_LIFETIME_MINUTES=8640
GRAPH_SUBSCRIPTION_RENEWAL_WINDOW_MINUTES=1440
GRAPH_SUBSCRIPTION_MAINTENANCE_INTERVAL_SECONDS=300
GRAPH_SUBSCRIPTION_CHANGE_TYPES=created,updated,deleted

GRAPH_DELTA_PAGE_SIZE=50
GRAPH_RECONCILIATION_INTERVAL_SECONDS=300

GRAPH_WORKER_POLL_INTERVAL_SECONDS=2
GRAPH_JOB_LEASE_SECONDS=120
GRAPH_JOB_MAX_ATTEMPTS=6
GRAPH_JOB_RETRY_BASE_SECONDS=5
GRAPH_JOB_RETRY_MAX_SECONDS=900
GRAPH_JOB_HEARTBEAT_INTERVAL_SECONDS=30

EVIDENCE_STORAGE_BACKEND=filesystem
FILESYSTEM_EVIDENCE_ROOT=./evidence
MAX_RAW_MIME_BYTES=26214400
MAX_ATTACHMENT_BYTES=26214400
MAX_ATTACHMENTS_PER_MESSAGE=25
QUARANTINE_UNKNOWN_ATTACHMENTS=true
