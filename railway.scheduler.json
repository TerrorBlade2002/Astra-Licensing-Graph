{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "app/**",
      "migrations/**",
      "alembic.ini",
      "pyproject.toml",
      "requirements.lock.txt",
      "Dockerfile",
      "railway.scheduler.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m app.workers.scheduler --once",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
