# Railway variable set for the frontend service. Railway passes these to the
# Docker build, where Vite inlines them into the public bundle.
#
# Only public values. A Graph secret, OpenAI key, database URL, SharePoint
# secret, or browser-session key here would be published to every visitor.

VITE_API_BASE_URL=https://api-staging.<approved-domain>/api/v1
VITE_ENTRA_TENANT_ID=<tenant-guid>
VITE_ENTRA_SPA_CLIENT_ID=<spa-app-registration-guid>
VITE_ENTRA_API_SCOPE=api://<api-app-registration-guid>/Licensing.Access
VITE_APP_ENV=staging
