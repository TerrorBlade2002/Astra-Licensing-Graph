# Railway variable set for the backend, worker, scheduler, and browser-worker
# services. Paste into the Railway raw variable editor per environment and
# replace every <placeholder>. Secrets are entered in Railway only; nothing
# here is committed with a real value.
#
# Staging and production keep entirely separate values. A staging service must
# never reference the production database, mailbox, SharePoint site, or portal
# account.

APP_ENV=staging                      # production: production
APP_VERSION=<git-sha-or-release-tag>
LOG_LEVEL=INFO
LOG_FORMAT=json

# Railway reference variable — do not paste a literal connection string.
DATABASE_URL=${{Postgres.DATABASE_URL}}

BACKEND_URL=https://api-staging.<approved-domain>
FRONTEND_URL=https://licensing-staging.<approved-domain>
CORS_ORIGINS=https://licensing-staging.<approved-domain>
PUBLIC_BASE_URL=https://api-staging.<approved-domain>

# --- Authentication ---------------------------------------------------------
AUTH_MODE=entra
ENTRA_TENANT_ID=<tenant-guid>
ENTRA_API_CLIENT_ID=<api-app-registration-guid>
ENTRA_API_AUDIENCE=api://<api-app-registration-guid>
ENTRA_API_SCOPE=Licensing.Access

# --- Microsoft Graph --------------------------------------------------------
GRAPH_ENABLED=true
GRAPH_TENANT_ID=<tenant-guid>
GRAPH_CLIENT_ID=<graph-app-registration-guid>
GRAPH_CREDENTIAL_MODE=client_secret
GRAPH_CLIENT_SECRET=<secret>          # Railway secret variable only
GRAPH_MAILBOX=<licensing-mailbox@domain>
GRAPH_EXPECTED_TENANT_ID=<tenant-guid>

# --- SharePoint -------------------------------------------------------------
SHAREPOINT_ENABLED=true
SHAREPOINT_PERMISSION_MODE=sites_selected
SHAREPOINT_SITE_ID=<site-id>
SHAREPOINT_EXPECTED_APP_ID=<graph-app-registration-guid>
SHAREPOINT_MASTER_DOCUMENTS_DRIVE_ID=<drive-id>
SHAREPOINT_WORKING_DOCUMENTS_DRIVE_ID=<drive-id>
SHAREPOINT_BONDS_DRIVE_ID=<drive-id>
SHAREPOINT_SUBMITTED_FILINGS_DRIVE_ID=<drive-id>
SHAREPOINT_LICENSES_DRIVE_ID=<drive-id>
SHAREPOINT_CORRESPONDENCE_DRIVE_ID=<drive-id>
SHAREPOINT_PAYMENTS_DRIVE_ID=<drive-id>
SHAREPOINT_FORMS_DRIVE_ID=<drive-id>
SHAREPOINT_QUARANTINE_DRIVE_ID=<drive-id>
EVIDENCE_STORAGE_BACKEND=sharepoint

# --- Classification ---------------------------------------------------------
CLASSIFICATION_ENABLED=true
CLASSIFICATION_REVIEW_REQUIRED=true
AI_CLASSIFICATION_ENABLED=false       # true only after written approval
AI_EXTERNAL_PROVIDER_APPROVED=false
AI_DATA_POLICY_ACKNOWLEDGED=false
# OPENAI_API_KEY=<secret>             # backend services only, never frontend
# OPENAI_MODEL=<model-id>

# --- Communications (enable in the go-live order, not all at once) ----------
COMMUNICATIONS_ENABLED=false
GRAPH_DRAFT_CREATION_ENABLED=false
GRAPH_SEND_ENABLED=false
GRAPH_MESSAGE_MOVE_ENABLED=false
COMMUNICATION_REQUIRE_SEND_APPROVAL=true
COMMUNICATION_REQUIRE_SEPARATE_SEND_APPROVER=true
COMMUNICATION_INITIAL_ROLLOUT_MODE=true

# --- Licensing --------------------------------------------------------------
LICENSING_ENABLED=true
LICENSING_REQUIRE_HUMAN_REVIEW=true
LICENSING_CROSS_ENTITY_REUSE_ENABLED=false
INFORMATION_ENCRYPTION_KEY_REFERENCE=<vault-or-kms-reference>
TRACKER_IMPORT_ENABLED=true
FORM_SIGNATURE_AUTOMATION_ENABLED=false
FORM_EXTERNAL_SUBMISSION_ENABLED=false

# --- Portal assistance (browser-worker only) --------------------------------
PORTAL_AUTOMATION_ENABLED=false
BROWSER_AUTOMATION_ENABLED=false
PORTAL_ALLOWED_HOSTS=
PORTAL_REQUIRE_ACTIVE_REVIEW=true
PORTAL_LOGIN_HUMAN_ONLY=true
PORTAL_MFA_HUMAN_ONLY=true
PORTAL_CAPTCHA_HUMAN_ONLY=true
PORTAL_TERMS_ACCEPTANCE_HUMAN_ONLY=true
PORTAL_ATTESTATION_HUMAN_ONLY=true
PORTAL_SIGNATURE_HUMAN_ONLY=true
PORTAL_PAYMENT_HUMAN_ONLY=true
PORTAL_FINAL_SUBMIT_HUMAN_ONLY=true
PORTAL_CAPTCHA_SOLVING_ENABLED=false
PORTAL_MFA_BYPASS_ENABLED=false
BROWSER_SESSION_STATE_PERSISTENCE=false
BROWSER_HEADLESS=true
BROWSER_TEMP_ROOT=/tmp/astra-portals
