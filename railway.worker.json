{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "app/**",
      "migrations/**",
      "alembic.ini",
      "pyproject.toml",
      "requirements.lock.txt",
      "Dockerfile",
      "railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m app.workers.runner --queues graph,ingestion,classification,documents,communications,licensing,requirements,deadlines,packets,forms,imports",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
