# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.pytest-tmp/
.coverage
coverage.xml
htmlcov/
.codex-*.log

# Node dependencies
node_modules/

# Frontend build and browser-test artifacts
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Prototype runtime data (contains real Graph IDs and mailbox content).
# Leading slash matters: an unanchored "evidence/" also matches app/evidence/,
# which silently excluded that package from version control and from any
# deployment that honours .gitignore.
/prototype-data/
/attachments/

# Local evidence store (mail content; never committed)
/evidence/

# Editor/OS
.idea/
.vscode/
Thumbs.db
