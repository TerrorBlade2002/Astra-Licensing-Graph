# Portal build configuration. Everything here ships inside the public bundle,
# so only non-secret values belong in this file.
#
# Never add: GRAPH_CLIENT_SECRET, OPENAI_API_KEY, DATABASE_URL, a SharePoint
# secret, or BROWSER_SESSION_ENCRYPTION_KEY_REFERENCE.

# Absolute API base URL in a deployed environment, e.g.
# https://api.example.com/api/v1. Locally the dev server proxies /api/v1.
VITE_API_BASE_URL=/api/v1

# Entra single-page-application registration. Leave empty to use the
# local/test synthetic actor mode.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SPA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=

VITE_APP_ENV=local
